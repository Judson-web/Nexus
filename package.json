{
  "name": "nexus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A TypeScript-first research project for a progressively trained language model.",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test src/model/*.test.ts src/tokenizer/*.test.ts",
    "train": "tsx src/cli.ts train",
    "generate": "tsx src/cli.ts generate"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "engines": { "node": ">=22" }
}
