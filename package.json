{
  "name": "nexus",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Nexus: a self-hosted, progressively trained language-model research project.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "tsc --noEmit",
    "test": "tsx --test src/model/*.test.ts src/tokenizer/*.test.ts src/training/*.test.ts",
    "train": "tsx src/cli.ts train",
    "generate": "tsx src/cli.ts generate"
  },
  "dependencies": { "next": "^15.5.0", "react": "^19.1.0", "react-dom": "^19.1.0" },
  "devDependencies": { "@types/node": "^22.15.0", "@types/react": "^19.1.0", "@types/react-dom": "^19.1.0", "tsx": "^4.19.0", "typescript": "^5.8.0" },
  "engines": { "node": ">=22" }
}
